<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.cyfko</groupId>
    <artifactId>filterql-adapter-jpa</artifactId>
    <version>2.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>JPA dynamic filtering composer for FilterQL</name>
    <description>
        ✨ JPA adapter for dynamic filtering allowing to compose predicates using intuitive boolean DSL.
        This version is **not backward compatible** with 1.x.
        See migration guide: https://github.com/cyfko/filter-ql#migration-guide
    </description>
    <url>https://github.com/cyfko/filter-ql</url>

    <developers>
        <developer>
            <name>Frank KOSSI</name>
            <email>frank.kossi@kunrin.com</email>
            <organization>Kunrin SA</organization>
            <organizationUrl>https://www.kunrin.com</organizationUrl>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>http://www.opensource.org/licenses/mit-license.php</url>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:git://github.com/cyfko/filter-ql</connection>
        <developerConnection>scm:git:git@github.com:cyfko/filter-ql.git</developerConnection>
        <url>https://github.com/cyfko/filter-ql/tree/main/adapters/java/jpa</url>
    </scm>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Plugin Versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.10.1</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.7</maven-gpg-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>

        <!-- AJOUT: Version explicite du release plugin -->
        <maven-release-plugin.version>3.1.1</maven-release-plugin.version>
        <central-publishing-plugin.version>0.7.0</central-publishing-plugin.version>

        <!-- Dependencies Versions -->
        <jakarta-persistence.version>3.1.0</jakarta-persistence.version>
        <filterql-core.version>4.0.0</filterql-core.version>
        <projection-spec.version>1.0.0</projection-spec.version>
        <jpa-processor.version>1.0.2</jpa-processor.version>

        <!-- Tests dependencies Versions -->
        <junit.version>5.10.3</junit.version>
        <mockito.version>5.12.0</mockito.version>
        <compile-testing.version>0.21.0</compile-testing.version>

    </properties>

    <dependencies>
        <!-- Dépendance vers le module core -->
        <dependency>
            <groupId>io.github.cyfko</groupId>
            <artifactId>filterql-core</artifactId>
            <version>${filterql-core.version}</version>
        </dependency>

        <!-- Dépendance vers le processeur d'annotation du metamodel de projection JPA générant des métadonnées utiles -->
        <dependency>
            <groupId>io.github.cyfko</groupId>
            <artifactId>jpa-metamodel-processor</artifactId>
            <version>${jpa-processor.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- Hibernate (JPA implementation) -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>6.6.8.Final</version>
            <scope>test</scope>
        </dependency>

        <!-- H2 Database pour tests en mémoire -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>2.3.232</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit Jupiter -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Mockito -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Compilation Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.github.cyfko</groupId>
                            <artifactId>jpa-metamodel-processor</artifactId>
                            <version>${jpa-processor.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Source Plugin (attach sources) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>${maven-source-plugin.version}</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Surefire Plugin (for running tests) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <argLine>
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.utils=ALL-UNNAMED

                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.relationship=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.ecommerce=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.policies=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.document=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.basic_operators=ALL-UNNAMED

                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.projection=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.projection._1=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.projection._2=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.projection._3=ALL-UNNAMED
                        --add-opens io.github.cyfko.filterql.jpa/io.github.cyfko.filterql.tests.entities.projection._4=ALL-UNNAMED
                    </argLine>
                </configuration>
            </plugin>
            <!-- Javadoc Plugin (attach javadocs) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${maven-javadoc-plugin.version}</version>
                <configuration>
                    <source>${java.version}</source>
                    <doclint>none</doclint>
                    <quiet>true</quiet>
                </configuration>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- AJOUT CRITIQUE : Configuration du Maven Release Plugin -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-release-plugin</artifactId>
                <version>${maven-release-plugin.version}</version>
                <configuration>
                    <!-- Créer des tags du style v1.0.0 au lieu de projection-spec-1.0.0 -->
                    <tagNameFormat>v@{project.version}</tagNameFormat>
                    <!-- Important: Activer le profil 'release' lors de l'exécution (perform) -->
                    <!-- Cela garantit que GPG et le Central Publishing plugin s'exécutent -->
                    <releaseProfiles>release</releaseProfiles>
                </configuration>
            </plugin>

        </plugins>
    </build>

    <!-- Profile for releasing to Maven Central -->
    <profiles>
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <!-- Central Publishing Plugin -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <!-- Publier automatiquement si la validation passe -->
<!--                            <autoPublish>true</autoPublish>-->
<!--                            <waitUntil>published</waitUntil>-->
                        </configuration>
                    </plugin>

                    <!-- GPG signing -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                                <!--                                <configuration>-->
                                <!--                                    &lt;!&ndash; Évite le prompt de passphrase si gpg-agent est configuré &ndash;&gt;-->
                                <!--                                    <gpgArguments>-->
                                <!--                                        <arg>&#45;&#45;pinentry-mode</arg>-->
                                <!--                                        <arg>loopback</arg>-->
                                <!--                                    </gpgArguments>-->
                                <!--                                </configuration>-->
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

    <!-- Distribution Management (for deploying) -->
    <distributionManagement>
        <snapshotRepository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/content/repositories/snapshots</url>
        </snapshotRepository>
        <!-- Note: Avec central-publishing-maven-plugin, le repository 'releases' ci-dessous
             n'est techniquement pas utilisé pour l'upload final vers le nouveau portail,
             mais il est bon de le laisser pour la compatibilité Maven standard. -->
        <repository>
            <id>ossrh</id>
            <url>https://s01.oss.sonatype.org/service/local/staging/deploy/maven2/</url>
        </repository>
    </distributionManagement>
</project>
